pipeline {
    agent any
    
    environment {
        // Enforce PowerShell Core as the default shell step execution
        JENKINS_POWERSHELL_COMMAND = 'pwsh'
        // SET FO BUILD ENVIRONMENT VARIABLES
        GOOS="windows"
        GOARCH="amd64"
        CGO_ENABLED="0"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Go Binary') {
            steps {
                printGoEnvironmentVariables('BEFORE BUILD')

                powershell '''
                    # 1. Create temporary workspace file
                    go work init

                    # 2. Link modules context locally
                    go work use ./example/module1
                    go work use ./example/helloworld

                    # 3. Compile the binary using the workspace mapping
                    go build -o ./example/helloworld/helloworld.exe ./example/helloworld

                    # 4. Cleanup workspace artifacts cleanly
                    Remove-Item go.work, go.work.sum -ErrorAction SilentlyContinue
                '''
            }
        }

    }


}

def printGoEnvironmentVariables(String comment) {
    powershell """
        Write-Host "Comment         = ${comment}"
        Write-Host "Stage           = ${env.STAGE_NAME}"
        
        # Single quotes protect these from Groovy manipulation completely
        Write-Host 'Env:GOOS        =' \$env:GOOS
        Write-Host 'Env:GOARCH      =' \$env:GOARCH
        Write-Host 'Env:CGO_ENABLED =' \$env:CGO_ENABLED
    """
}