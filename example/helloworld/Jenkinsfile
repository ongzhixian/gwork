pipeline {
    agent any
    
    environment {
        // Enforce PowerShell Core as the default shell step execution
        JENKINS_POWERSHELL_COMMAND = 'pwsh'
        // SET FO BUILD ENVIRONMENT VARIABLES
        GOOS="windows"
        GOARCH="amd64"
        CGO_ENABLED="0"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Go Binary') {
            when {
                script {
                    // Extract all change sets from the current build
                    def changeLogSets = currentBuild.changeSets
                    
                    for (int i = 0; i < changeLogSets.size(); i++) {
                        def entries = changeLogSets[i].items
                        for (int j = 0; j < entries.length; j++) {
                            def entry = entries[j]
                            
                            // Iterate through the affected paths of each commit
                            def files = entry.affectedPaths
                            for (int k = 0; k < files.size(); k++) {
                                echo "Modified File: ${files[k]}"
                            }
                        }
                    }
                }

                expression {
                    // 1. If manually triggered (empty changeset), run native PowerShell Git diff
                    if (currentBuild.changeSets.isEmpty()) {
                        // Returns 0 (success) if the pattern matches a changed file path
                        def exitCode = powershell(
                            script: "git diff --name-only HEAD~1 HEAD | Select-String -Pattern '^example/helloworld/' -Quiet", 
                            returnStatus: true
                        )
                        // In PowerShell, -Quiet returns True/False. 
                        // Jenkins returnStatus captures the exit status (0 means a match was found)
                        return exitCode == 0
                    }
                    
                    // 2. If triggered by SCM webhook, standard Jenkins changeset rules apply
                    return currentBuild.changeSets.any { changeLogSet ->
                        changeLogSet.items.any { entry ->
                            entry.affectedPaths.any { path -> path.startsWith('example/helloworld/') }
                        }
                    }
                }
            }
            steps {
                printGoEnvironmentVariables('BEFORE BUILD')



                powershell '''
                    # 1. Initialize the temporary workspace
                    go work init
                    go work use ./example/module1
                    go work use ./example/helloworld

                    # 2. Resync the workspace metadata with your checked-in vendor folder
                    go work vendor

                    # 3. Compile by explicitly reusing the synchronized vendor directory
                    go build -mod=vendor -o ./example/helloworld/helloworld.exe ./example/helloworld

                    # 4. Cleanup workspace files, leaving your vendor folder untouched
                    Remove-Item go.work, go.work.sum -ErrorAction SilentlyContinue
                '''
            }
        }

    }

    post {
        success {
            // Archive the zip file in Jenkins for record-keeping
            //archiveArtifacts artifacts: 'helloworld.exe', fingerprint: true
            archiveArtifacts artifacts: 'example/helloworld/helloworld.exe', fingerprint: true
        }
    }


}

def printGoEnvironmentVariables(String comment) {
    powershell """
        Write-Host "Comment         = ${comment}"
        Write-Host "Stage           = ${env.STAGE_NAME}"
        
        # Single quotes protect these from Groovy manipulation completely
        Write-Host 'Env:GOOS        =' \$env:GOOS
        Write-Host 'Env:GOARCH      =' \$env:GOARCH
        Write-Host 'Env:CGO_ENABLED =' \$env:CGO_ENABLED
    """
}